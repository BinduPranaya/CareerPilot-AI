# Leave GEMINI_API_KEY blank to run fully offline in deterministic mock mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local persistent Chroma store (used when CHROMA_HOST is blank)
CHROMA_PATH=./chroma_data

# Set these to point at a standalone Chroma server (e.g. the docker-compose "chroma" service)
CHROMA_HOST=
CHROMA_PORT=8000
